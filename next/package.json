{
  "name": "sports-fiesta-s9-web",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components hooks lib proxy.ts",
    "test": "npm run test --workspace @sports-fiesta/domain",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @sports-fiesta/domain && npm run typecheck --workspace @sports-fiesta/theme",
    "db:schema": "set -a; . ./.env.local; set +a; psql \"$DATABASE_URL\" -f scripts/supabase-schema.sql",
    "db:seed": "tsx scripts/seed-supabase.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@sports-fiesta/domain": "*",
    "@sports-fiesta/theme": "*",
    "@supabase/supabase-js": "^2.109.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "lucide-react": "latest",
    "next": "latest",
    "next-themes": "^0.4.6",
    "react": "latest",
    "react-dom": "latest",
    "react-icons": "^5.7.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.13.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "latest",
    "@tailwindcss/postcss": "latest",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/ws": "^8.18.1",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "tailwindcss": "latest",
    "tsx": "^4.23.1",
    "typescript": "latest",
    "vitest": "^4.1.0"
  }
}
