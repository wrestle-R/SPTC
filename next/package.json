{
  "name": "sports-fiesta-s9-web",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "functions"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components hooks lib proxy.ts",
    "test": "npm run test --workspace @sports-fiesta/domain",
    "test:functions": "npm run test --workspace @sports-fiesta/functions",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @sports-fiesta/domain && npm run typecheck --workspace @sports-fiesta/firebase && npm run typecheck --workspace @sports-fiesta/theme && npm run typecheck --workspace @sports-fiesta/functions",
    "build:functions": "npm run build --workspace @sports-fiesta/functions",
    "emulators": "firebase emulators:start"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@sports-fiesta/domain": "*",
    "@sports-fiesta/firebase": "*",
    "@sports-fiesta/theme": "*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.16.0",
    "firebase-admin": "^13.5.0",
    "framer-motion": "^12.23.24",
    "lucide-react": "latest",
    "next": "latest",
    "next-themes": "^0.4.6",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "^3.8.0",
    "shadcn": "^4.13.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "latest",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "firebase-tools": "^14.11.2",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vitest": "^4.1.0"
  }
}
