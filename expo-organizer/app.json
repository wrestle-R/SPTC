{
  "expo": {
    "name": "Sports Fiesta Organizer",
    "slug": "sports-fiesta-s9-organizer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/sports-fiesta-logo.png",
    "scheme": "sportsfiestaorganizer",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/sports-fiesta-logo.png",
      "bundleIdentifier": "com.sptc.sportsfiesta.organizer"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111210",
        "foregroundImage": "./assets/images/sports-fiesta-logo.png"
      },
      "package": "com.sptc.sportsfiesta.organizer",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/sports-fiesta-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111210",
          "image": "./assets/images/sports-fiesta-logo.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
